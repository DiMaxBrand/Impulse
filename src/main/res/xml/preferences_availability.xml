<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
    Manual availability is broken on the current (Compose) UI — the only picker that lets you
    actually choose a manual value lives in the legacy EditAccountActivity "change status" menu,
    and nothing routes users there anymore. Rather than ship a toggle whose "on" state silently
    does nothing, it's hidden here (AppSettings.isUserManagedAvailability() is also hardcoded to
    false, and existing users are migrated back to automatic — see AppSettings.migratePreferences).
    Un-comment once a working manual-availability picker exists again.
    <SwitchPreferenceCompat
        android:defaultValue="@bool/manually_change_presence"
        android:disableDependentsState="true"
        android:icon="@drawable/ic_announcement_24dp"
        android:key="manually_change_presence"
        android:summary="@string/pref_manually_change_presence_summary"
        android:title="@string/pref_manually_change_presence" />
    -->
    <SwitchPreferenceCompat
        android:defaultValue="@bool/away_when_screen_off"
        android:icon="@drawable/ic_screen_lock_portrait_24dp"
        android:key="away_when_screen_off"
        android:summary="@string/pref_away_when_screen_off_summary"
        android:title="@string/pref_away_when_screen_off" />
    <SwitchPreferenceCompat
        android:defaultValue="@bool/away_when_app_exited"
        android:icon="@drawable/ic_logout_24dp"
        android:key="away_when_app_exited"
        android:summary="@string/pref_away_when_app_exited_summary"
        android:title="@string/pref_away_when_app_exited" />
    <!-- The name of the key reflects the old functionality but will be reused -->
    <SwitchPreferenceCompat
        android:defaultValue="@bool/dnd_sync_system"
        android:icon="@drawable/ic_do_not_disturb_on_24dp"
        android:key="dnd_on_silent_mode"
        android:summary="@string/pref_sync_system_dnd_summary"
        android:title="@string/pref_sync_system_dnd" />
    <!-- The name of the key mirrors the old (pre DND mode) functionality. Elsewhere in the app it will be referred to as DND_INCLUDE_SILENT_MODES -->
    <SwitchPreferenceCompat
        android:defaultValue="@bool/dnd_include_silent_modes"
        android:dependency="dnd_on_silent_mode"
        android:icon="@drawable/ic_vibration_24dp"
        android:key="treat_vibrate_as_silent"
        android:summary="@string/pref_include_silent_modes_summary"
        android:title="@string/pref_include_silent_modes" />
</androidx.preference.PreferenceScreen>